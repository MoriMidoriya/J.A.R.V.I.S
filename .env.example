# Copy to .env and fill in only what you use. All optional — Jarvis runs fully local without any key.

# Cloud LLM providers (LiteLLM model strings: anthropic/..., openai/..., gemini/..., groq/..., openrouter/...)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cloud TTS (optional)
ELEVENLABS_API_KEY=

# Override any settings.yaml value with JARVIS__SECTION__KEY, e.g.:
# JARVIS__LLM__PRIMARY=anthropic/claude-sonnet-4-5
